FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY backend/pyproject.toml ./
COPY backend/sdtf ./sdtf
COPY backend/alembic.ini ./
RUN pip install --upgrade pip && pip install ".[postgres,columnar]"
RUN useradd -r -u 10001 sdtf && mkdir -p /app/data && chown -R sdtf /app
USER sdtf
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz')" || exit 1
CMD ["sh", "-c", "alembic upgrade head && uvicorn sdtf.main:app --host 0.0.0.0 --port 8000 --workers ${SDTF_WEB_WORKERS:-2}"]
