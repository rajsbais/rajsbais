# Required in production (RFACTORY_ENV=production refuses to start without them)
RFACTORY_AUTH=oidc
RFACTORY_OIDC_ISSUER=https://idp.example.com/
RFACTORY_OIDC_AUDIENCE=keystone
RFACTORY_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# Fernet key: python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'
RFACTORY_STATE_KEY=
RFACTORY_AUDIT_KEY=

# Browser login (Authorization Code + PKCE, public client)
RFACTORY_OIDC_AUTHORIZE_URL=https://idp.example.com/authorize
RFACTORY_OIDC_TOKEN_URL=https://idp.example.com/token
RFACTORY_OIDC_CLIENT_ID=keystone-ui
# RFACTORY_OIDC_END_SESSION_URL=https://idp.example.com/logout

# Optional
# RFACTORY_OIDC_REQUIRE_JTI=1      refuse tokens that cannot be revoked individually
# RFACTORY_HSTS=1                  only behind HTTPS
# RFACTORY_MAX_BODY_BYTES=5242880
# Password variables referenced by connection profiles (password_ref: env:SAP_ECC_PW), for example:
# SAP_ECC_PW=
